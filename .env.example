# API key from your provider. Never commit the real one.
LLM_API_KEY=your-api-key

# Base URL from your provider's docs.
LLM_BASE_URL=your-base-url

# Model name from your provider's model list.
LLM_MODEL=your-model-name
# Postgres connection string, for example postgresql://user:password@localhost:5433/dbname
DATABASE_URL=your-database-url

# Optional model settings. The measured runs used these values.
# LLM_THINKING=off
# LLM_MAX_TOKENS=800

# Only for docker compose: the database container's password.
# Use the same password inside DATABASE_URL above (host localhost, port 5433).
POSTGRES_PASSWORD=your-database-password

# Optional, live review (python -m cuad_ai worker, streamlit run app/live_app.py).
# LIVE_API=1 switches on the HTTP endpoints. Each client then has its own key (python -m cuad_ai live-admin key CLIENT),
# sent as X-API-Key. Leave unset to keep the endpoints off.
# LIVE_API=1
# LIVE_MAX_CHARS=400000        text length after reading the file
# LIVE_MAX_FILE_MB=10          size of the uploaded file itself
# LIVE_MAX_PAGES=300           PDF pages
# LIVE_DAILY_CAP=20            uploads per client per 24 hours (a client can have its own cap)
# LIVE_GLOBAL_DAILY_CAP=100    uploads across all clients per 24 hours
# LIVE_RETENTION_DAYS=30       default days before an upload is deleted (a client can have its own)
# LIVE_TOKEN_CAP=400000
# LIVE_WORKERS=4
# Hosted only (deploy/live): sign-in is set in the app's Secrets ([auth] sections), not here. See docs/deploy-live.md.
# HOSTED_DATABASE_URL is used by scripts/copy_bank.py and `live-admin --hosted`.
