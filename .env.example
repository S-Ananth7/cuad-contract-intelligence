# API key from your provider. Never commit the real one.
LLM_API_KEY=your-api-key

# Base URL from your provider's docs.
LLM_BASE_URL=your-base-url

# Model name from your provider's model list.
LLM_MODEL=your-model-name
# Postgres connection string, for example postgresql://user:password@localhost:5433/dbname
DATABASE_URL=your-database-url
